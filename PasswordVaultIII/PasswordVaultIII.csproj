<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>PasswordVaultIII</RootNamespace>
    <AssemblyName>PasswordVaultIII</AssemblyName>
    <ApplicationIcon>PassVault.ICO</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- This is a Windows-only WinForms app, not a cross-platform library, so the
         platform-compatibility analyzer's warnings about Windows-only APIs are noise. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="System.Data.OleDb" Version="8.0.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The compiled encryption library from the original PasswordVaultII app (its source
         is long gone, but this binary still works). It's only used, if present, to recover
         real passwords when importing that app's Access database - see
         Data/LegacyPasswordDecryptor.cs. Not needed once that one-time migration is done. -->
    <Content Include="clsPWV.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
